# Copy to .env. Never put real secrets in HTML, Firebase, or Git.
OPENROUTER_API_KEY=
# Pick a model that supports structured outputs (json_schema).
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Separate password for access to paid AI calls; minimum 16 characters.
AI_ACCESS_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Set the exact external HTTPS origin when deploying (no trailing slash).
APP_ORIGIN=http://localhost:3000
# preview: reads live data, NEVER writes Firestore; local draft edits only.
# cloud: explicitly enables existing Firebase write flows after review/testing.
APP_DATA_MODE=preview
AI_MAX_REQUESTS_PER_HOUR=20
AI_MAX_OUTPUT_TOKENS=5000
AI_TIMEOUT_MS=90000
