# Optional local static preview only. AI config is public in src/ai_service.js.
# Keys belong to each user's browser; there is no app AI backend.
HOST=127.0.0.1
PORT=3000
# Address displayed by the local static preview server (no trailing slash).
APP_ORIGIN=http://localhost:3000
# preview: reads live data, NEVER writes Firestore; local draft edits only.
# cloud: explicitly enables existing Firebase write flows after review/testing.
APP_DATA_MODE=preview
